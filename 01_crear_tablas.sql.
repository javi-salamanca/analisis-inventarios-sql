-- Eliminar tabla si ya existe para evitar conflictos al reiniciar
DROP TABLE IF EXISTS productos;

-- 1. Creación de la tabla principal de productos e inventario
CREATE TABLE productos (
    id_producto INTEGER PRIMARY KEY AUTOINCREMENT,
    codigo_sku TEXT NOT NULL,
    nombre_producto TEXT NOT NULL,
    categoria TEXT NOT NULL,
    stock_actual INTEGER NOT NULL,
    stock_minimo_rop INTEGER NOT NULL, -- Punto de Reorden (Reorder Point)
    costo_unitario REAL NOT NULL,
    demanda_anual_estimada INTEGER NOT NULL
);

